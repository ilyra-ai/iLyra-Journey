# =============================================================================
# Lyra MetaCare · modelo de configuração (.env.example)
# =============================================================================
# Este arquivo é a documentação versionada das variáveis do projeto e NÃO
# contém segredos. A configuração real fica em `.env.local` (ignorado pelo Git)
# e é a fonte única usada por Next.js, scripts do banco, Docker Compose e
# launchers.
#
# Para criar ou completar o `.env.local`:
#   pnpm env:init
#
# O comando copia os valores padrão abaixo, gera os segredos marcados como
# "gerado automaticamente" com aleatoriedade criptográfica, nunca sobrescreve
# valores existentes e grava o arquivo com permissão 0600.
#
# O Docker Compose lê este mesmo arquivo: `docker compose --env-file .env.local`
# (os scripts `pnpm db:*` e os launchers já fazem isso).

# -----------------------------------------------------------------------------
# Banco de dados (MySQL 9.7 LTS via Docker Compose)
# -----------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
# Porta publicada no host (compose.yaml) e porta usada pela aplicação.
MYSQL_HOST_PORT=3307
MYSQL_PORT=3307
MYSQL_DATABASE=lyra_metacare
MYSQL_USER=lyra
# Senha do usuário da aplicação. Gerado automaticamente.
MYSQL_PASSWORD=
# Senha do root do MySQL (usada só pelo container e por `pnpm db:upgrade`).
# Gerado automaticamente.
MYSQL_ROOT_PASSWORD=

# -----------------------------------------------------------------------------
# Autenticação
# -----------------------------------------------------------------------------
# Chave HS256 das sessões (mínimo de 32 bytes). Gerado automaticamente.
AUTH_SECRET=

# Administrador criado ou atualizado por `pnpm db:migrate`.
ADMIN_BOOTSTRAP_EMAIL=admin@lyra.local
# Gerado automaticamente; consulte o valor no seu `.env.local`.
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FIRST_NAME=Admin
ADMIN_BOOTSTRAP_LAST_NAME=Lyra
# Opcional: administradores extras em JSON, por exemplo
# '[{"email":"ana@exemplo.com","password":"<senha forte>","firstName":"Ana","lastName":"Souza"}]'
ADMIN_BOOTSTRAP_ADDITIONAL_ADMINS=

# -----------------------------------------------------------------------------
# URLs da aplicação (retornos do Stripe e links absolutos)
# -----------------------------------------------------------------------------
# Em produção, APP_BASE_URL é obrigatória para o checkout e o portal da Stripe
# (a origem da requisição só é usada fora de produção) e também é aceita como
# origem legítima pela proteção CSRF (src/proxy.ts). Atrás de um proxy reverso,
# configure-o para sobrescrever X-Forwarded-For, usado pelos limites por IP.
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Opcional · Modelo do Gemini usado no chat quando a pessoa informa a própria
# chave (BYOK). O modelo de IA da plataforma (local, como Ollama, LM Studio,
# Jan e llama.cpp, ou em nuvem) é escolhido em Admin → Modelos de IA e fica no
# banco, com a chave cifrada; não há variável de ambiente para ele.
# -----------------------------------------------------------------------------
GEMINI_MODEL=gemini-2.5-flash

# Memória Graphiti. O serviço é privado e usa índices semânticos locais.
# A pessoa ativa a memória na interface; o padrão por conta é desligado.
LYRA_MEMORIA_URL=http://127.0.0.1:8019
LYRA_MEMORIA_PORTA=8019
# Endereço do Next.js visto pelo contêiner (ajuste a porta se necessário).
LYRA_MEMORIA_APP_URL=http://host.docker.internal:3000
# Gerados automaticamente; nunca reutilize a chave de autenticação do app.
LYRA_MEMORIA_SEGREDO=
LYRA_MEMORIA_BANCO_SENHA=

# Serviço de treinamento da Lyra (tarefa 90): treina os pesos de um modelo
# aberto com o feedback do administrador no chat e o serve em
# ${LYRA_TREINO_URL}/v1 como o modelo local "lyra-treinavel".
# O segredo é gerado por pnpm env:init.
LYRA_TREINO_URL=http://127.0.0.1:8021
LYRA_TREINO_PORTA=8021
LYRA_TREINO_SEGREDO=

# -----------------------------------------------------------------------------
# Opcional · Stripe (checkout, portal e webhooks). O jeito recomendado é
# cadastrar as chaves em Admin → Pagamentos (cifradas no banco, com teste de
# conexão), um conjunto para teste e outro para produção, e escolher lá o
# ambiente em uso; as de lá valem mais que estas, que ficam como alternativa
# (o ambiente é o do prefixo da chave: sk_test_/rk_test_ ou sk_live_/rk_live_).
# Use chaves de teste em desenvolvimento; sem chave em nenhum dos dois lugares,
# o billing externo fica desativado e a API responde 503 de forma explícita.
# Mercado Pago e PayPal só existem no painel.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# IDs de preço por plano pago (STRIPE_PRICE_<PLANO>_<MONTHLY|ANNUAL>), usados
# só com as chaves acima; com as chaves do painel valem os preços cadastrados
# lá para o ambiente em uso.
STRIPE_PRICE_META_MONTHLY=
STRIPE_PRICE_META_ANNUAL=
STRIPE_PRICE_CARE_MONTHLY=
STRIPE_PRICE_CARE_ANNUAL=

# -----------------------------------------------------------------------------
# Opcional · Armazenamento de imagens (avatares). Vazio = pasta storage/ do
# projeto; em produção, aponte para um volume persistente (caminho absoluto).
# -----------------------------------------------------------------------------
LYRA_STORAGE_DIR=

# -----------------------------------------------------------------------------
# Opcional · LGPD. E-mail do encarregado pelo tratamento de dados (DPO),
# exibido na política de privacidade (/privacidade). Vazio = a política indica
# os canais de atendimento da empresa que opera a instância.
# -----------------------------------------------------------------------------
LGPD_CONTATO_EMAIL=

# -----------------------------------------------------------------------------
# Opcional · coach diário. A rotina que prepara o "Seu dia" de cada pessoa
# (a partir das 3 h locais) roda dentro do servidor Node.js a cada 15 minutos.
# COACH_ROTINA=desligada desliga essa rotina interna (ex.: hospedagem sem
# processo contínuo); nesse caso, configure COACH_ROTINA_SEGREDO (mínimo de 32
# caracteres, gere com `openssl rand -base64 48`) e chame
# POST /api/coach/rotina com `Authorization: Bearer <segredo>` pelo cron da
# hospedagem. Sem segredo, a rota responde 404.
# -----------------------------------------------------------------------------
COACH_ROTINA=
COACH_ROTINA_SEGREDO=

# -----------------------------------------------------------------------------
# Opcional · Sentry. Sem DSN, o SDK não envia eventos; a coleta de dados
# pessoais e de saúde vem desligada no código.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
# Apenas para upload de source maps no build.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# -----------------------------------------------------------------------------
# Opcional · desenvolvimento
# -----------------------------------------------------------------------------
# `true` registra o loader do Dyad no `pnpm dev:webpack`.
ENABLE_DYAD_COMPONENT_TAGGER=
